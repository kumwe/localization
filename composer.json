{
  "name": "kumwe/localization",
  "description": "Portable locale negotiation, layered message catalogues and ICU formatting.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/localization",
  "support": {
    "issues": "https://github.com/kumwe/localization/issues",
    "source": "https://github.com/kumwe/localization"
  },
  "require": {
    "php": "^8.5",
    "ext-intl": "*",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "ext-zip": "*",
    "laminas/laminas-servicemanager": "^4.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Localization\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Localization\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "composer:validate": "composer validate --strict",
    "release:check": "bash tools/test-release-record.sh",
    "lint": "php tools/lint.php",
    "docs": "php tools/check-docblocks.php",
    "architecture": "php tools/verify-architecture.php",
    "manifests": "php tools/verify-manifests.php",
    "manifests:record": "php tools/verify-manifests.php --write",
    "autoload:smoke": "php resources/toolchain/autoload-smoke.php",
    "examples": "php examples/translate.php",
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit",
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "check": [
      "@composer:validate",
      "@security:audit",
      "@release:check",
      "@lint",
      "@docs",
      "@architecture",
      "@extraction:check",
      "@manifests",
      "@autoload:smoke",
      "@examples",
      "@cs",
      "@analyse",
      "@test",
      "@clean-consumer",
      "@release:integrity"
    ],
    "security:audit": "composer audit --abandoned=fail",
    "extraction:check": "php tools/verify-extraction.php",
    "release:integrity": "bash tools/test-release-integrity.sh"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
